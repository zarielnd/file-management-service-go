# Git
.git
.gitignore
.gitattributes

# Documentation
docs/
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment (secrets)
.env
.env.*
!.env.example

# Build artifacts
bin/
tmp/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.out

# Docker (not needed inside images)
docker-compose*.yml
docker-compose*.yaml
Dockerfile*
.dockerignore

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

apps/web/

# Dependencies (downloaded inside container)
vendor/

# Infrastructure (Terraform state, secrets, provider cache)
infra/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.lock.hcl

# CI/CD (not needed in production images)
.github/

# Go workspace (breaks module-based Docker builds)
go.work
go.work.sum

# Build tooling (not needed at runtime)
Makefile
buf.gen.yaml

# Scripts (unless they are container entrypoints)
scripts/

# Root-level terraform state (I see one at root in your tree)
terraform.tfstate
terraform.tfstate.*